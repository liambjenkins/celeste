modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "nano"]

[agent]
expertMode = true

# Do not put real credentials in this file — it's committed to git.
# Set WORLDTIDES_API_KEY, EARTHDATA_USERNAME, EARTHDATA_PASSWORD in
# Replit's Secrets tab (padlock icon in the sidebar) instead.
