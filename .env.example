# Copy this file to .env and fill in real values.
# .env is gitignored — your real keys never get committed.

# --- WorldTides (providers/tides.py) ---------------------------------
# Powers the "tide" concept. Free trial: 100 credits on signup
# (~50 lookups), then pay-as-you-go.
# Get a key: https://www.worldtides.info/developer/apikey
WORLDTIDES_API_KEY=

# --- NASA Earthdata (providers/land.py, via earthaccess) -------------
# Powers soil moisture / soil temperature (GLDAS). Free, no limit.
# Create an account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Optional: knowledge/claims LLM extraction (not required to run
# main.py — only needed if you're extracting new candidate claims
# from source documents via knowledge/claims/pipeline.py) -------------
# CELESTE_LLM_ENDPOINT=
# CELESTE_LLM_API_KEY=
# CELESTE_LLM_MODEL=

# --- web.py (daily-mode web scaffold) ---------------------------------
# Birth data, deliberately not hardcoded (see task history: "Un-hardcode
# birth data in main.py").
CELESTE_BIRTH_DATE=
CELESTE_BIRTH_TIME=
CELESTE_TIMEZONE=
CELESTE_LATITUDE=
CELESTE_LONGITUDE=

# Optional. If unset, daily.py's reading assembly falls back to its
# deterministic path (ordering + connector phrases) automatically —
# the page still works either way.
ANTHROPIC_API_KEY=

# Optional. Without these, /edit still saves locally to
# data/feedback_log.jsonl, but on Render's free tier that file is
# lost on every spin-down/redeploy — set these to also commit each
# edit durably to the GitHub repo. CELESTE_GITHUB_TOKEN needs a
# fine-grained PAT scoped to Contents:write on this one repo only.
CELESTE_GITHUB_TOKEN=
CELESTE_GITHUB_REPO=
CELESTE_GITHUB_BRANCH=main
