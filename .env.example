# Copy this file to .env and fill in real values.
# .env is gitignored — your real keys never get committed.

# --- WorldTides (providers/tides.py) ---------------------------------
# Powers the "tide" concept. Free trial: 100 credits on signup
# (~50 lookups), then pay-as-you-go.
# Get a key: https://www.worldtides.info/developer/apikey
WORLDTIDES_API_KEY=

# --- NASA Earthdata (providers/land.py, via earthaccess) -------------
# Powers soil moisture / soil temperature (GLDAS). Free, no limit.
# Create an account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Optional: knowledge/claims LLM extraction (not required to run
# main.py — only needed if you're extracting new candidate claims
# from source documents via knowledge/claims/pipeline.py) -------------
# CELESTE_LLM_ENDPOINT=
# CELESTE_LLM_API_KEY=
# CELESTE_LLM_MODEL=
